{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{png,jpg,jpeg,gif,ico,svg,webp}",
      "/*.{css,js,json,txt,map}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000 https: data: blob:;"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
